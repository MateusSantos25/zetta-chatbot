# Arquivos compilados do Python (gerados automaticamente ao rodar o código)
__pycache__/
*.py[cod]

# Ambiente virtual (cada máquina cria o seu com: pip install -r requirements.txt)
.venv/
venv/

# Segredos: chaves de API nunca vão para o repositório
.env
.streamlit/secrets.toml

# Configurações pessoais do editor
.vscode/

# Cache de ferramentas de qualidade de código (Ruff, pytest)
.ruff_cache/
.pytest_cache/

# Instruções pessoais de configuração do Claude Code
CLAUDE.md
